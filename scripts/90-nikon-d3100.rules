# Udev-Regeln für Nikon D3100
# Diese Regeln deaktivieren automatisch das Einhängen der Kamera als Wechseldatenträger
# und verhindern, dass gvfs und andere Prozesse das Gerät beanspruchen

ACTION!="add", GOTO="nikonD3100_rules_end"
SUBSYSTEM!="usb", GOTO="nikonD3100_rules_end"

# Nikon D3100 (angepasst an die VID:PID der Kamera)
ATTRS{idVendor}=="04b0", ATTRS{idProduct}=="0425", MODE="0666", GROUP="plugdev", ENV{ID_MEDIA_PLAYER}="1", TAG+="uaccess", TAG+="udev-acl"

# Für alle Nikon-Geräte im allgemeinen
ATTRS{idVendor}=="04b0", MODE="0666", GROUP="plugdev", ENV{GPHOTO2_DRIVER}="PTP", ENV{ID_MEDIA_PLAYER}="1", TAG+="uaccess", TAG+="udev-acl"

# Verhindern, dass gvfs-gphoto2-volume-monitor und andere Services die Kamera mounten
ATTRS{idVendor}=="04b0", ENV{UDISKS_AUTO}="0", ENV{UDISKS_IGNORE}="1"
ATTRS{idVendor}=="04b0", ENV{LIBMTP_DEVICE}="1", ENV{ID_MTP_DEVICE}="1", ENV{ID_GPHOTO}="1", ENV{GVFS_DISABLE_PTP}="1"

LABEL="nikonD3100_rules_end"
